{
  "name": "simorgh-ledger",
  "private": true,
  "version": "1.0.85",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.simorgh.ledger",
    "productName": "Simorgh",
    "asar": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis", "artifactName": "Simorgh-Setup-${version}.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/vazirmatn": "^5.2.8",
    "@zxing/browser": "^0.2.0",
    "adhan": "^4.4.3",
    "moment-hijri": "^3.0.0",
    "moment-jalaali": "^0.10.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/moment-jalaali": "^0.7.9",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
