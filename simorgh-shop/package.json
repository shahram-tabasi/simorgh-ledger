{
  "name": "simorgh-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "صندوقِ فروشگاهیِ سیمرغ — POS سبک با بارکد، فاکتور، صندوق و اسکنرِ بی‌سیمِ گوشی",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.simorgh.shop",
    "productName": "SimorghShop",
    "asar": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "server/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis", "artifactName": "SimorghShop-Setup-${version}.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.0.0",
    "@zxing/browser": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "express": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
